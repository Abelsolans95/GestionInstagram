# Copia este fichero a .env para desarrollo local. NUNCA subas .env al repo.
# En Railway estas variables se configuran en el panel del servicio (Variables).

# --- Meta / Instagram ---
# unified   = "API setup with Unified login" (recomendado por Meta; graph.facebook.com)
# instagram = "API setup with Instagram login" (graph.instagram.com)
META_LOGIN=unified
# unified:   identificador y clave secreta de la app de Meta (Configuración de la app > Básica)
# instagram: Instagram App ID y Instagram app secret (API setup with Instagram login)
IG_APP_ID=
IG_APP_SECRET=
# unified:   token de usuario del sistema generado en "Generate access tokens" (no caduca por defecto)
# instagram: token de usuario de Instagram de larga duración (60 días; el servicio lo refresca solo)
IG_ACCESS_TOKEN=
# ID de tu cuenta profesional de Instagram
# unified:   el "id" de GET graph.facebook.com/v27.0/me/assigned_instagram_accounts
# instagram: el "user_id" de GET graph.instagram.com/v27.0/me?fields=user_id,username
IG_USER_ID=
# Texto que inventas tú y pegas también en "Verify token" al configurar el webhook en Meta
WEBHOOK_VERIFY_TOKEN=

# --- Claude ---
ANTHROPIC_API_KEY=
# Solo si Anthropic responde "This API key is not scoped to a workspace": el ID del workspace
# (wrkspc_…, en console.anthropic.com > Settings > Workspaces). Mejor: crea la key dentro de un workspace.
# ANTHROPIC_WORKSPACE_ID=

# --- Respuestas ---
# Delay aleatorio antes de publicar cada respuesta (segundos)
REPLY_DELAY_MIN=60
REPLY_DELAY_MAX=300
# Tope de respuestas publicadas por hora (ventana móvil de 60 min)
MAX_REPLIES_PER_HOUR=60
# true = guardar las respuestas para revisión manual sin publicarlas
REVIEW_MODE=true

# --- Informes y página de revisión ---
# Token largo y aleatorio (16+ caracteres) para /report, /participants, /review y /status (?token=...)
REPORT_TOKEN=

# --- Opcionales ---
# Dar me gusta a los comentarios que se responden. Según Meta solo funciona con "Facebook Login"
# y el permiso instagram_manage_engagement; si Meta lo rechaza, se desactiva solo.
# LIKE_REPLIED_COMMENTS=false
# No responder comentarios más antiguos que N horas (0 = responder todos)
# MAX_REPLY_AGE_HOURS=0
# Plan B si los webhooks no llegan: leer comentarios cada N segundos (0 = apagado; mínimo 30)
# POLL_INTERVAL_SECONDS=0
# POLL_MEDIA_COUNT=5
# CLAUDE_MODEL=claude-haiku-5-5
# META_API_VERSION=v27.0
# DATABASE_PATH=./data/app.db
# PORT=3000
# LOG_LEVEL=info
