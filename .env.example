# Copia este fichero a .env para desarrollo local. NUNCA subas .env al repo.
# En Railway estas variables se configuran en el panel del servicio (Variables).

# --- Meta / Instagram (Instagram API con Instagram Login) ---
# App ID y App secret de Instagram: App Dashboard > Instagram > API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
# Token de usuario de Instagram de larga duración (60 días). El servicio lo refresca solo.
IG_ACCESS_TOKEN=
# ID de tu cuenta profesional (el campo user_id de GET /me?fields=user_id,username)
IG_USER_ID=
# Texto que inventas tú y pegas también en "Verify token" al configurar el webhook en Meta
WEBHOOK_VERIFY_TOKEN=

# --- Claude ---
ANTHROPIC_API_KEY=

# --- Comportamiento de las respuestas ---
# Delay aleatorio antes de publicar cada respuesta (segundos)
REPLY_DELAY_MIN=60
REPLY_DELAY_MAX=300
# Tope de respuestas publicadas por hora (ventana móvil)
MAX_REPLIES_PER_HOUR=60
# true = guardar respuestas para revisión manual sin publicarlas
REVIEW_MODE=true

# --- Informes ---
# Token largo y aleatorio para /report y /participants (?token=...)
REPORT_TOKEN=

# --- Opcionales ---
# PORT=3000
# LOG_LEVEL=info
