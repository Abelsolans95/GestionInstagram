{
  "name": "humanidaddesdecero-comments",
  "version": "0.1.0",
  "private": true,
  "description": "Respuestas automáticas y análisis de comentarios de Instagram (@humanidaddesdecero) con la API oficial de Meta y Claude",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate:webhook": "tsx scripts/simulate-webhook.ts",
    "question": "node dist/src/cli/question.js",
    "reextract": "node dist/src/cli/reextract.js",
    "import:comments": "node dist/src/cli/import.js",
    "test:live": "vitest run --config vitest.live.config.ts",
    "review": "node dist/src/cli/review.js",
    "token": "node dist/src/cli/token.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  }
}
