# Copia este archivo como .env y rellénalo. El .env no se sube a git.

# --- Cuenta SECUNDARIA con la que el vigía lee los comentarios (no uses tu cuenta principal) ---
IG_USUARIO=
IG_PASSWORD=

# --- Qué vigilar ---
REEL_URL=https://www.instagram.com/reel/Df0UAOiRhtL/
# Cuenta(s) desde las que TÚ comentas en el sorteo, separadas por comas (sin @)
MIS_CUENTAS=humanidaddesdecero
# Cada cuántos minutos mira (se le suma un margen aleatorio de 0-2 min)
INTERVALO_MIN=15
# 1 = te avisa en cada vuelta aunque no cambie nada; 0 = solo si algo cambia
AVISAR_SIEMPRE=0

# --- Avisos por correo (Gmail). Necesitas una "contraseña de aplicación" de Google ---
GMAIL_USUARIO=
GMAIL_APP_PASSWORD=
# A quién se envía (si lo dejas vacío, a GMAIL_USUARIO)
AVISAR_A=

# --- (Opcional) Notificación al móvil con la app gratuita ntfy ---
# Inventa un nombre largo y difícil de adivinar y suscríbete a él en la app ntfy
NTFY_TEMA=
